#!/usr/bin/env sh
if git diff --cached --name-only | grep -E -q '^(frontend/|backend/|build\.bat|build_pl\.bat|config-prompts\.inc\.bat|install-ttrpg-vendor\.inc\.bat|sync-current-source\.inc\.bat|write-deploy-env\.ps1|index\.php|deploy-env\.php)'; then
  export BUILD_NONINTERACTIVE=1
  export CI=1
  cmd.exe //c build.bat || exit 1
  git add table-manager/current-source
fi