# Allowed origins, add here your domain, that you host your app on
ALLOWED_ORIGINS=https://domain.pl,http://localhost:5173

# Limit of uploaded table assets (tokens, maps, backgrounds, templates, PDFs). 0 = unlimited.
VTT_TABLE_UPLOAD_QUOTA_MB=50

# Dev only: show table-manager/public/vtt/global in map elements, tokens and backgrounds.
# Table Manager writes this per table. Leave it unset in a built package.
# VTT_GLOBAL_ASSETS=1
# VTT_GLOBAL_ASSETS_PATH=