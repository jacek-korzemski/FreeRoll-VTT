# Blokada dostępu do .env
<FilesMatch "^\.env">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Blokada dostępu do plików danych
<FilesMatch "state\.json$|rolls\.json$|ttrpg\.sqlite$|ttrpg\.sqlite-(journal|wal|shm)$|secrets\.json$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Zezwolenie na publiczne szablony HTML
<If "%{REQUEST_URI} =~ m#^/backend/assets/templates/.*\.html$#">
    Require all granted
</If>

# Blokada listowania katalogów
Options -Indexes

# vendor/ i src/ są tylko do include z api.php — nie serwuj ich HTTP
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^vendor/ - [F]
    RewriteRule ^src/ - [F]
    RewriteRule ^include/ - [F]
</IfModule>