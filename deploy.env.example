# Deployment configuration for build/ folder (copy to build/.env)
# Generated automatically by build.bat or clone.bat
#
# VTT_COLOR_TEMPLATE: crimson | ember | forest | ocean | violet
# (all palettes ship in the package; this only selects which one to apply)

VTT_PASSWORD=2137
VTT_GM_PASSWORD=admin
VTT_BASE_PATH=/vtt/room1/
VTT_LANGUAGE=en
VTT_COLOR_TEMPLATE=crimson
VTT_ENABLE_L5R=false
ALLOWED_ORIGINS=*
