# Production build (build.bat writes a temporary .env with these values).
# Local dev uses frontend/.env.development instead (Vite loads it for npm run dev).
#
# if you host your VTT in "root" folder of your domain, use "/". Otherwise
# you can setup in which folder it's running like domain.com/vtt/room1
# so you can install multiple instances of game on one domain
VITE_BASE_PATH=/vtt/room1/

# URL do API (względem base path w produkcji; w dev pełny URL w .env.development)
VITE_API_PATH=backend/api.php

# Język interfejsu (en / pl)
VITE_LANGUAGE=en

# Szablon kolorystyczny w `npm run dev` (crimson / ember / forest / ocean / violet).
# W produkcji wybór idzie z .env / window.__VTT_CONFIG__.colorTemplate.
VITE_COLOR_TEMPLATE=crimson

# Wsparcie Legendy Pieciu Kregow (kosci, import karty CSV/TSV, kompendium, pickery).
# Bramka BUILD-TIME: gdy 'false', caly kod L5R jest usuwany z paczki (tree-shaking).
# Ustaw 'true' w dev (frontend/.env) aby pracowac nad funkcjami L5R.
VITE_ENABLE_L5R=false